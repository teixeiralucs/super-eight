# ─── Supabase (Project Settings → API) ────────────────────────────────
# Públicas: expostas ao navegador.
PUBLIC_SUPABASE_URL=""
# Chave anon (legacy) ou a nova "publishable key" (sb_publishable_...).
PUBLIC_SUPABASE_ANON_KEY=""

# ─── Banco de dados (Supabase → botão "Connect") ──────────────────────
# Runtime da aplicação: Transaction pooler (porta 6543).
DATABASE_URL=""
# Migrações do Prisma: Session pooler (porta 5432) ou conexão direta.
# (A conexão direta do Supabase é apenas IPv6; use o Session pooler se sua rede não tiver IPv6.)
DIRECT_URL=""

# ─── TMDb (themoviedb.org → Settings → API) ───────────────────────────
# "API Read Access Token" (v4). Nunca prefixar com PUBLIC_.
TMDB_READ_ACCESS_TOKEN=""

# ─── Trakt (trakt.tv/oauth/applications → seu app) ────────────────────
# Só o "Client ID": as listas oficiais são públicas (sem OAuth). Nunca prefixar com PUBLIC_.
# Vazio = coleções do Trakt desligadas (o resto do app funciona).
TRAKT_CLIENT_ID=""

# ─── Vercel Cron ──────────────────────────────────────────────────────
# String aleatória longa (ex.: `openssl rand -hex 32`).
CRON_SECRET=""

# Só em desenvolvimento: e-mail da conta de teste usada por /dev/login-as
DEV_LOGIN_EMAIL=
