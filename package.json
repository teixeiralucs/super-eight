{
	"name": "super-eight",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "svelte-kit sync && prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"check": "node scripts/compile-messages.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"library:backup": "tsx scripts/library-backup.ts",
		"library:restore": "tsx scripts/library-restore.ts",
		"movies:backfill-i18n": "tsx scripts/movies-backfill-i18n.ts",
		"errors": "tsx scripts/client-errors.ts",
		"i18n:compile": "node scripts/compile-messages.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"cn": "^0.4.0",
		"dotenv": "18.0.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "7.10.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@fontsource/mr-dafoe": "^5.3.0",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.117.2",
		"fflate": "^0.8.3",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"prisma@7.10.0": true,
		"@prisma/engines@7.10.0": true
	}
}
