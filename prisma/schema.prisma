generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WatchStatus {
  WANT_TO_WATCH
  WATCHED
}

/// Ranking = numerada, ordem manual; Coleção = sem números, ordenada por quem vê.
enum ListKind {
  RANKED
  COLLECTION
}

enum CatalogType {
  POPULAR
  NOW_PLAYING
}

model User {
  id                String   @id @db.Uuid // = auth.users.id (criado por trigger)
  email             String   @unique
  username          String   @unique
  name              String?
  avatarUrl         String?
  bio               String?
  /// Idioma escolhido ("pt" | "en" | "es"); nulo = segue o navegador.
  locale            String?
  /// País (ISO 3166-1) para "Em cartaz", populares e estreia local; nulo = automático.
  region            String?
  /// Perfil privado: só nome, @ e listas públicas aparecem; fica fora do feed (§6.6).
  isPrivate         Boolean  @default(false)
  /// Streamings que a pessoa assina (IDs de WatchProvider), destacados em "Onde assistir" (§6.12).
  streamingServices Int[]    @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  library           LibraryEntry[]
  artworks          MovieArtwork[]
  hiddenCollections HiddenCollection[]
  diary             DiaryEntry[]
  lists             List[]
  reviews           Review[]
  comments          Comment[]
  reviewLikes       ReviewLike[]
  listLikes         ListLike[]
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("following")
  notifications     Notification[]     @relation("recipient")
  notificationsSent Notification[]     @relation("actor")
}

model Movie {
  id               Int       @id // TMDb ID
  /// Título no idioma original (pode ser português, inglês, russo, chinês…) — o destaque na UI.
  originalTitle    String?
  /// ISO 639-1 do idioma original (ex.: "ja").
  originalLanguage String?
  /// Títulos traduzidos (nulo = sem tradução; a UI cai no original).
  titlePt          String?
  titleEn          String?
  titleEs          String?
  /// Pôster de cada idioma (o texto do pôster muda); o DNA do usuário tem prioridade.
  posterPt         String?
  posterEn         String?
  posterEs         String?
  /// Logo padrão do título para cada idioma de quem vê (ver pickLogo); o DNA do usuário tem prioridade.
  logoPt           String?
  logoEn           String?
  logoEs           String?
  backdropPath     String?
  releaseDate      DateTime? @db.Date
  runtime          Int?
  /// IDs de gênero do TMDb; o nome vem traduzido no idioma de quem vê.
  genreIds         Int[]     @default([])
  directors        String[]  @default([])
  countries        String[]  @default([]) // ISO 3166-1 (ex.: "US")
  voteAverage      Float?
  /// Coleção do TMDb (saga) a que o filme pertence; nula = nenhuma.
  collectionId     Int?
  /// ID do IMDb (o Trakt aceita para descobrir listas oficiais).
  imdbId           String?
  /// Quando as listas oficiais do Trakt com este filme foram buscadas; nulo = ainda não.
  traktCheckedAt   DateTime?
  /// Quando "onde assistir" foi buscado (todas as regiões); nulo = ainda não.
  watchCheckedAt   DateTime?
  /// IDs do TMDb para os filtros da biblioteca (§6.10): pessoas por função e estúdios.
  directorIds      Int[]     @default([])
  writerIds        Int[]     @default([])
  /// Os 30 primeiros do elenco.
  castIds          Int[]     @default([])
  composerIds      Int[]     @default([])
  studioIds        Int[]     @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  collection     Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  libraryEntries LibraryEntry[]
  artworks       MovieArtwork[]
  diaryEntries   DiaryEntry[]
  listItems      ListMovie[]
  reviews        Review[]
  catalogEntries CatalogEntry[]
  watch          MovieWatch[]

  @@index([collectionId])
}

/// Coleção do TMDb (ex.: "Star Wars"): só leitura; o usuário vê os filmes dela que tem na biblioteca.
model Collection {
  id           Int      @id // ID do TMDb
  /// Nome por idioma (nulo = sem tradução; a UI cai no inglês).
  namePt       String?
  nameEn       String
  nameEs       String?
  posterPath   String?
  backdropPath String?
  /// Todos os filmes da coleção no TMDb, por ordem de lançamento ("3 de 8").
  partIds      Int[]    @default([])
  /// Dados de cada parte para os "fantasmas" (filmes que o usuário não tem): ver CollectionPart.
  parts        Json     @default("[]")
  updatedAt    DateTime @updatedAt

  movies Movie[]
}

/// Lista oficial do Trakt (curadoria: box sets, estúdios…), exibida como coleção (§6.8).
/// Os filmes ficam em `partIds` (IDs do TMDb): a coleção aparece para quem tem algum deles.
model TraktList {
  id          Int      @id // ID do Trakt
  slug        String
  name        String
  description String?
  /// Filmes da lista com ID do TMDb, em ordem de lançamento.
  partIds     Int[]    @default([])
  /// Título (inglês, do Trakt) e data de cada filme, para os fantasmas (ver CollectionPart).
  parts       Json     @default("[]")
  updatedAt   DateTime @updatedAt

  @@index([partIds], type: Gin)
}

/// Coleção que o usuário escondeu da aba Coleções (saga do TMDb ou lista oficial do Trakt).
model HiddenCollection {
  userId       String           @db.Uuid
  source       CollectionSource
  collectionId Int
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, source, collectionId])
}

enum CollectionSource {
  TMDB
  TRAKT
}

model LibraryEntry {
  userId     String      @db.Uuid
  movieId    Int
  status     WatchStatus
  rating     Int? // 1–10 (CHECK via SQL)
  isFavorite Boolean     @default(false)
  addedAt    DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id])

  @@id([userId, movieId])
  @@index([userId, status])
}

/// "DNA" visual do filme para um usuário: pôster/fundo escolhidos na galeria (qualquer idioma).
/// Vale em toda a área logada (dashboard, busca, listas). Nulo = imagem padrão do TMDb.
model MovieArtwork {
  userId       String   @db.Uuid
  movieId      Int
  posterPath   String?
  backdropPath String?
  logoPath     String?
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id])

  @@id([userId, movieId])
}

/// Onde assistir um filme numa região (TMDb, dados do JustWatch — §6.12). Renovado pela rotina
/// diária; guarda todas as regiões que o TMDb devolve.
model MovieWatch {
  movieId   Int
  /// ISO 3166-1 (ex.: "BR").
  region    String
  /// Página do TMDb com os links de cada serviço.
  link      String?
  /// IDs de WatchProvider: assinatura, grátis (inclui com anúncios), aluguel e compra.
  flatrate  Int[]    @default([])
  free      Int[]    @default([])
  rent      Int[]    @default([])
  buy       Int[]    @default([])
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, region])
  @@index([region])
}

/// Serviço de streaming/loja (TMDb): nome, logo e prioridade de exibição.
model WatchProvider {
  id        Int      @id
  name      String
  logoPath  String?
  /// Menor = mais relevante (ordem do TMDb).
  priority  Int      @default(999)
  updatedAt DateTime @updatedAt
}

model DiaryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  movieId   Int
  watchedAt DateTime @db.Date
  rating    Int? // 1–10 (CHECK via SQL)
  isRewatch Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id])

  @@index([userId, watchedAt(sort: Desc)])
  @@index([userId, movieId])
}

model List {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  kind        ListKind @default(COLLECTION)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ListMovie[]
  likes         ListLike[]
  notifications Notification[]
  comments      Comment[]

  @@index([userId])
}

model ListMovie {
  listId   String   @db.Uuid
  movieId  Int
  position Int
  note     String?
  addedAt  DateTime @default(now())

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id])

  @@id([listId, movieId])
  @@index([listId, position])
}

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  movieId          Int
  content          String
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie         Movie          @relation(fields: [movieId], references: [id])
  likes         ReviewLike[]
  comments      Comment[]
  notifications Notification[]

  @@unique([userId, movieId])
  @@index([movieId, createdAt(sort: Desc)])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model ReviewLike {
  userId    String   @db.Uuid
  reviewId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model ListLike {
  userId    String   @db.Uuid
  listId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// Comentário numa review OU numa lista (CHECK no banco: exatamente um dos dois).
  reviewId  String?  @db.Uuid
  listId    String?  @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list   List?   @relation(fields: [listId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([reviewId, createdAt])
  @@index([listId, createdAt])
}

model CatalogEntry {
  type     CatalogType
  position Int
  movieId  Int
  syncedAt DateTime    @default(now())

  movie Movie @relation(fields: [movieId], references: [id])

  @@id([type, position])
}

enum NotificationType {
  /// Começou a seguir você.
  FOLLOW
  /// Curtiu sua review.
  REVIEW_LIKE
  /// Curtiu sua lista.
  LIST_LIKE
  /// Comentou na sua review.
  REVIEW_COMMENT
  /// Comentou numa review que você também comentou.
  REVIEW_REPLY
  /// Comentou na sua lista.
  LIST_COMMENT
  /// Comentou numa lista que você também comentou.
  LIST_REPLY
}

/// Aviso para `userId` sobre algo que `actorId` fez (§6.13). Desfazer (descurtir, deixar de
/// seguir, apagar o comentário/review/lista) apaga o aviso.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  actorId   String           @db.Uuid
  type      NotificationType
  reviewId  String?          @db.Uuid
  listId    String?          @db.Uuid
  commentId String?          @db.Uuid
  /// Nulo = não lido.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  review  Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list    List?    @relation(fields: [listId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

/// Erros vistos no navegador de quem usa o app (console), agrupados por assinatura
/// (mensagem + origem + rota). Só o servidor grava/lê; `npm run errors` lista (§6.4.7).
model ClientError {
  id        String   @id @default(uuid()) @db.Uuid
  /// Hash da mensagem, da primeira linha útil da pilha e da rota (sem IDs).
  signature String   @unique
  message   String
  stack     String?
  /// Página onde aconteceu da última vez.
  url       String
  /// Rota do SvelteKit (ex.: /movie/[id]).
  route     String?
  /// Onde foi pego: boundary (parte da tela), window (erro solto) ou rejection (promessa).
  source    String
  userAgent String?
  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen(sort: Desc)])
}
